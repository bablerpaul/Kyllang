# RPC endpoint of your test network (e.g. Ganache, Alchemy, Infura)
RPC_URL=HTTP://127.0.0.1:7545

# private key for the wallet that will sign transactions (e.g. MetaMask account)
PRIVATE_KEY=<REPLACE_WITH_DEVELOPMENT_PRIVATE_KEY>

# deployed smart contract address
CONTRACT_ADDRESS=0xDA0bab807633f07f013f94DD0E6A4F96F8742B53

# ── KYLLANG_V4 Phase 1 (VRF) ─────────────────────────────
VRF_HOSPITAL_SECRET=your-256-bit-vrf-key-replace-in-prod

# ── KYLLANG_V4 Phase 2 (TPRE Proxy Nodes) ────────────────
TPRE_THRESHOLD=3
PROXY_NODE_1_URL=local
PROXY_NODE_2_URL=local
PROXY_NODE_3_URL=local
PROXY_NODE_4_URL=local
PROXY_NODE_5_URL=local
ZK_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
EMERGENCY_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# ── NETWORK DEPLOYMENT TOPOLOGY ──────────────────────────
# TRUST_PROXY must be explicitly configured according to the actual production reverse-proxy topology.
# Do not blindly use 1 or true.
# Leave unset/false for direct deployment.
# Configure explicitly when deployed behind a trusted reverse proxy.
# The value must match the actual production topology (e.g. 1 for one hop, or specific IP subnets).
TRUST_PROXY=

